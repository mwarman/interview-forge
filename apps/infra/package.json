{
  "name": "@interview-forge/infra",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "cdk": "cdk",
    "cdk:deploy": "cdk deploy --require-approval never",
    "cdk:destroy": "cdk destroy --all --force",
    "precdk:synth": "npm run build",
    "cdk:synth": "cdk synth",
    "clean": "rimraf cdk.out coverage dist",
    "test": "vitest run --silent passed-only",
    "test:coverage": "vitest run --coverage --silent passed-only"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "26.6.5",
    "aws-cdk": "2.1145.0",
    "aws-cdk-lib": "2.273.0",
    "constructs": "10.8.1",
    "dotenv": "18.0.7",
    "esbuild": "0.28.2",
    "zod": "4.6.5"
  }
}
